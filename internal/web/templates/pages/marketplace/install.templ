package marketplace

import (
	"fmt"

	"github.com/fr4nsys/usulnet/internal/web/templates/layouts"
)

// InstallData is the view model for the per-app install form.
type InstallData struct {
	PageData layouts.PageData
	App      AppView
	Fields   []FieldView
	Error    string
	Name              string
	ExposePublicly    bool
	ExposureDomain    string
	ExposureService   string
	ExposurePort      int
	ExposureWebSocket bool
}

// FieldView is the input descriptor for one configurable field.
type FieldView struct {
	Key         string
	Label       string
	Description string
	Type        string
	Default     string
	Required    bool
	Options     []string
	Placeholder string
}

templ Install(data InstallData) {
	@layouts.Base(data.PageData) {
		<div class="space-y-6">
			@Nav("browse")

			<div class="max-w-2xl">
				<h2 class="text-lg font-semibold text-white mb-1">Install { data.App.Name }</h2>
				<p class="text-sm text-gray-400 mb-4">Configure deployment settings</p>

				if data.Error != "" {
					<div class="mb-4 px-3 py-2 bg-red-500/10 border border-red-500/20 rounded-lg text-sm text-red-400">
						<i aria-hidden="true" class="fas fa-exclamation-triangle mr-2"></i>{ data.Error }
					</div>
				}

				<form method="POST" action={ templ.SafeURL("/marketplace/" + data.App.Slug + "/install") } class="space-y-4">
					<div>
						<label class="block text-sm font-medium text-gray-300 mb-1">Stack name</label>
						<input type="text" name="name" required placeholder={ data.App.Slug }
							value={ installName(data) }
							class="w-full px-3 py-2 bg-dark-600 border border-dark-500 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-primary-500" aria-label="Stack name"/>
						<p class="text-xs text-gray-500 mt-1">This becomes the stack name. Lowercase letters, digits, and dashes work best.</p>
					</div>

					<div class="border-t border-dark-600 pt-4 space-y-3">
						<label class="flex items-center gap-2 text-sm font-medium text-gray-300">
							<input type="checkbox" name="expose_publicly" value="true" checked?={ data.ExposePublicly } class="rounded border-dark-500 bg-dark-600"/>
							Expose this application through the reverse proxy
						</label>
						<p class="text-xs text-gray-500">The root domain redirects permanently to the canonical www address. DNS must already point to this server.</p>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
							<div class="md:col-span-2">
								<label class="block text-sm font-medium text-gray-300 mb-1">Domain</label>
								<input type="text" name="exposure_domain" value={ data.ExposureDomain } placeholder="example.com" class="w-full px-3 py-2 bg-dark-600 border border-dark-500 rounded-lg text-white placeholder-gray-500"/>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-300 mb-1">Compose service</label>
								<input type="text" name="exposure_service" value={ data.ExposureService } placeholder="web" class="w-full px-3 py-2 bg-dark-600 border border-dark-500 rounded-lg text-white placeholder-gray-500"/>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-300 mb-1">Container port</label>
								<input type="number" name="exposure_port" min="1" max="65535" value={ exposurePortValue(data.ExposurePort) } placeholder="80" class="w-full px-3 py-2 bg-dark-600 border border-dark-500 rounded-lg text-white placeholder-gray-500"/>
							</div>
						</div>
						<label class="flex items-center gap-2 text-sm text-gray-400">
							<input type="checkbox" name="exposure_websocket" value="true" checked?={ data.ExposureWebSocket } class="rounded border-dark-500 bg-dark-600"/>
							Enable WebSocket/streaming support
						</label>
					</div>

					if len(data.Fields) > 0 {
						<div class="border-t border-dark-600 pt-4">
							<h3 class="text-sm font-semibold text-white mb-3">Configuration</h3>
							for _, field := range data.Fields {
								<div class="mb-3">
									<label class="block text-sm font-medium text-gray-300 mb-1">
										{ field.Label }
										if field.Required {
											<span class="text-red-400">*</span>
										}
									</label>
									if field.Type == "select" && len(field.Options) > 0 {
										<select name={ "field_" + field.Key }
											class="w-full px-3 py-2 bg-dark-600 border border-dark-500 rounded-lg text-gray-300 focus:outline-none focus:border-primary-500">
											for _, opt := range field.Options {
												<option value={ opt } selected?={ opt == field.Default }>{ opt }</option>
											}
										</select>
									} else if field.Type == "password" {
										<input type="password" name={ "field_" + field.Key }
											value={ field.Default }
											placeholder={ field.Placeholder }
											class="w-full px-3 py-2 bg-dark-600 border border-dark-500 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-primary-500" aria-label={ field.Placeholder }/>
									} else {
										<input type="text" name={ "field_" + field.Key }
											value={ field.Default }
											placeholder={ field.Placeholder }
											class="w-full px-3 py-2 bg-dark-600 border border-dark-500 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-primary-500" aria-label={ field.Placeholder }/>
									}
									if field.Description != "" {
										<p class="text-xs text-gray-500 mt-1">{ field.Description }</p>
									}
								</div>
							}
						</div>
					}

					<div class="flex gap-3 pt-2">
						<button type="submit" class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-black font-medium rounded-lg transition-colors text-sm">
							<i aria-hidden="true" class="fas fa-download mr-2"></i>Install
						</button>
						<a href={ templ.SafeURL("/marketplace/" + data.App.Slug) } class="px-4 py-2 bg-dark-600 hover:bg-dark-500 text-gray-300 rounded-lg transition-colors text-sm">
							Cancel
						</a>
					</div>
				</form>
			</div>
		</div>
	}
}

func installName(data InstallData) string {
	if data.Name != "" {
		return data.Name
	}
	return data.App.Slug
}

func exposurePortValue(port int) string {
	if port == 0 {
		return ""
	}
	return fmt.Sprintf("%d", port)
}
